# Comma-separated subscription UUIDs; credentials are supplied by Azure CLI locally
# or the Function App's managed identity in Azure.
AZURE_SUBSCRIPTIONS=00000000-0000-0000-0000-000000000000

# Required for managed-identity Blob access. Local connection-string fallback is optional.
AZURE_STORAGE_ACCOUNT_URL=https://example.blob.core.windows.net
# AZURE_STORAGE_CONNECTION_STRING=<local-only secret; never commit a real value>
REPORT_CONTAINER=waste-reports

# Required webhook secret. Keep it in a local secret store or Function App setting.
LOGIC_APP_WEBHOOK=https://example.logic.azure.com/workflows/<placeholder>

CPU_THRESHOLD=2
MIN_METRIC_SAMPLES=5
RUN_BUDGET_SECONDS=240
MAX_RESOURCES_PER_RUN=500

# Live pricing fails closed. Explicit overrides are optional monthly USD values;
# disk values are USD per GB per month, keyed by exact SKU.
PRICING_MODE=live
# PRICING_JSON={"vm":{"Standard_B2s":36.0},"disk":{"Premium_LRS":0.12},"lb":{"Standard":18.0},"postgres":{"Standard_D2s_v3":120.0}}
PRICING_CACHE_TTL_SECONDS=3600

RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=200
