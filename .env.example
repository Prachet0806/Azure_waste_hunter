AZURE_SUBSCRIPTIONS=sub-id-1,sub-id-2
# Optional: overrides the first subscription from AZURE_SUBSCRIPTIONS for Monitor calls
AZURE_SUBSCRIPTION_ID=sub-id-1

LOGIC_APP_WEBHOOK=https://example.logic.azure.com/workflows/...
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
REPORT_CONTAINER=waste-reports

CPU_THRESHOLD=2

# Pricing
PRICING_MODE=live
# PRICING_JSON={"vm":{"Standard_B2s":36.0},"disk":{"Standard_LRS":0.05},"lb":18.0,"postgres":120.0}
# PRICING_FILE=/var/task/pricing.json
PRICING_CACHE_TTL_SECONDS=3600

# Retries
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=200

# Observability (set by Azure when App Insights is enabled)
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
